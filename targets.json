            },
            {
              "fill": ".shelf-search",
              "text": "rtl"
            },
            {
              "waitFor": ".shelf-title:has-text(\"fxl-rtl\")",
              "timeout": 15000
            },
            {
              "waitFor": ".shelf-title:has-text(\"Reflowable Chapters\")",
              "state": "detached",
              "timeout": 15000
            },
            {
              "fill": ".shelf-search",
              "text": ""
            },
            {
              "waitFor": ".shelf-title:has-text(\"Reflowable Chapters\")",
              "timeout": 15000
            },
            {
              "select": ".shelf-sort select",
              "value": "title"
            },
            {
              "waitFor": ".shelf-item:first-child .shelf-title:has-text(\"fxl-explicit-spreads\")",
              "timeout": 15000
            }
          ]
        },
        {
          "path": "/",
          "name": "reading",
          "open": [
            ".sample .primary",
            {
              "waitFor": ".spread",
              "timeout": 40000
            },
            {
              "waitFor": ".chrome-top.hidden",
              "timeout": 15000
            }
          ]
        },
        {
          "path": "/",
          "name": "fix-layout",
          "open": [
            ".sample .primary",
            {
              "waitFor": ".spread",
              "timeout": 40000
            },
            "button[aria-expanded]",
            {
              "waitFor": ".menu"
            }
          ]
        },
        {
          "path": "/",
          "name": "contents",
          "open": [
            ".sample .primary",
            {
              "waitFor": ".spread",
              "timeout": 40000
            },
            "button[aria-expanded]",
            {
              "waitFor": ".menu"
            },
            {
              "waitFor": ".contents-jump:has-text('Begin Reading')"
            },
            ".contents-jump:has-text('Begin Reading')",
            {
              "waitFor": ".menu",
              "state": "detached",
              "timeout": 15000
            },
            "button[aria-expanded]",
            {
              "waitFor": ".menu"
            },
            {
              "waitFor": ".contents-jump.contents-here:has-text('Begin Reading')",
              "timeout": 15000
            }
          ]
        },
        {
          "path": "/",
          "name": "locked",
          "open": [
            ".sample .primary",
            {
              "waitFor": ".spread",
              "timeout": 40000
            },
            ".lock",
            {
              "waitFor": ".lock-on"
            },
            {
              "press": "Tab"
            },
            {
              "waitFor": ".chrome-top:not(.hidden)"
            }
          ],
          "holdAfterOpen": true
        },
        {
          "path": "/",
          "name": "pinch-zoom",
          "viewports": [
            "touch"
          ],
          "open": [
            ".sample .primary",
            {
              "waitFor": ".spread",
              "timeout": 40000
            },
            {
              "pinch": ".spread",
              "scale": 2.5
            },
            {
              "waitFor": ".zoom-layer[style*=\"scale\"]",
              "timeout": 15000
            },
            {
              "waitFor": ".chrome-top.hidden",
              "timeout": 15000
            }
          ]
        },
        {
          "path": "/",
