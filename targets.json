            {
              "waitFor": ".spread",
              "timeout": 40000
            },
            {
              "tap": ".lock"
            },
            {
              "waitFor": ".lock-on",
              "timeout": 15000
            },
            {
              "waitFor": ".chrome-top.hidden",
              "timeout": 15000
            }
          ]
        },
