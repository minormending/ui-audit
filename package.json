{
  "name": "ui-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated UI/design testing harness for static GitHub Pages projects",
  "scripts": {
    "fetch:targets": "node scripts/fetch-targets.js",
    "build:targets": "node scripts/build-targets.js",
    "serve": "node scripts/serve.js",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "report": "playwright show-report",
    "review": "node scripts/design-review.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.63.0"
  }
}
